// Grafana Alloy pipeline for True Shuffle.
// Reads container logs from the local Docker daemon, parses the backend's
// JSON log lines, and writes them to Grafana Cloud Logs.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Keep only the application containers, and turn Docker's container name
// (which is prefixed with "/") into a queryable "container" label.
discovery.relabel "apps" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/true_shuffle_(flask|celery_worker)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "apps" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.apps.output
  labels     = { job = "true_shuffle" }
  forward_to = [loki.process.apps.receiver]
}

loki.process "apps" {
  forward_to = [loki.write.gcl.receiver]

  // The backend emits single-line JSON. Non-JSON lines (Gunicorn lifecycle
  // logs, crash traces) pass through untouched.
  stage.json {
    expressions = {
      level          = "level",
      service        = "service",
      correlation_id = "correlation_id",
      user_id        = "user_id",
      task_id        = "task_id",
    }
  }

  // Low-cardinality fields become labels so they can be used in stream
  // selectors and metric queries, e.g. {container="true_shuffle_flask", level="ERROR"}.
  stage.labels {
    values = {
      level   = "level",
      service = "service",
    }
  }

  // High-cardinality trace fields stay out of the label index and are stored
  // as structured metadata instead.
  stage.structured_metadata {
    values = {
      correlation_id = "correlation_id",
      user_id        = "user_id",
      task_id        = "task_id",
    }
  }
}

loki.write "gcl" {
  endpoint {
    url = sys.env("GCL_LOKI_URL")

    basic_auth {
      username = sys.env("GCL_INSTANCE_ID")
      password = sys.env("GCL_TOKEN")
    }
  }
}
